# Wyze Doorbell Bridge — Configuration
#
# Copy this file to .env and fill in your credentials.

# === Required: Wyze account credentials ===
WYZE_EMAIL=you@example.com
WYZE_PASSWORD=your-password-here

# API keys — get these from https://developer-api-console.wyze.com/
WYZE_KEY_ID=your-key-id
WYZE_API_KEY=your-api-key

# === Optional: Device selection ===
# If you have multiple cameras, specify which one to stream.
# Leave blank to auto-detect the first GW_ model (doorbell).
#DEVICE_MAC=

# === Relay configuration ===
# Mode: "proxy" (uses Mars as fallback) or "relay" (fully offline after first auth)
RELAY_MODE=proxy

# Enable doorbell keepalive (prevents doorbell from sleeping between sessions)
# Set to "1" for sub-5s time-to-first-frame (requires initial wakeup)
RELAY_KEEPALIVE=0

# Upstream Mars relay (only used in proxy mode, auto-resolved from DNS)
#RELAY_UPSTREAM=3.13.212.24:28800

# === Network / P2P ===
# Known doorbell LAN IP (for injection fallback if broadcast times out)
#DOORBELL_IP=192.168.1.81
#DOORBELL_PORT=8899

# P2P port type: 0=IPv6+IPv4 broadcast (default), 1=IPv4 only, 2=IPv4 alt
#P2P_PORT_TYPE=0

# Max time to wait for doorbell broadcast response (seconds)
#LAN_WAIT=90

# === Paths ===
# Auth token cache file (7-day Mars token TTL)
#CACHE_FILE=cache/auth.json
