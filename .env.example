# Wyze Doorbell Bridge — Configuration
#
# Copy to .env and fill in your credentials.
# See docs/configuration.md for full reference and deployment tiers.

# --- Wyze Account (required) ---
WYZE_EMAIL=your-email@example.com
WYZE_PASSWORD=your-password
WYZE_KEY_ID=your-key-id
WYZE_API_KEY=your-api-key

# --- Device (required) ---
DOORBELL_IP=192.168.1.81

# --- Bridge (Tier 1: Hybrid — uses Mars for CALLING only) ---
P2P_URL=|18.118.90.161
RELAY_MODE=relay
RELAY_KEEPALIVE=1
LAN_ONLY=1
LAN_WAIT=15
SUBSCRIBE_WAIT=3
SKIP_WAKEUP=0

# --- For Tier 2 (Fully Offline), change to: ---
# P2P_URL=|127.0.0.1
# SKIP_WAKEUP=1
# LAN_WAIT=0

# --- Optional ---
# CHIME_IP=192.168.1.12
# GATEWAY_IP=192.168.1.1
# LOG_LEVEL=info
