# Wyze Camera Bridge — Configuration
# Copy to .env and fill in credentials. No IP addresses required.
# The bridge auto-discovers all cameras on your account and LAN.

# --- Wyze Account (required) ---
WYZE_EMAIL=your-email@example.com
WYZE_PASSWORD=your-password
WYZE_KEY_ID=your-key-id
WYZE_API_KEY=your-api-key

# --- Camera Selection ---
# 'all'  — enroll every GW_* camera on the account (default)
# 'MAC'  — enroll only this camera: AA:BB:CC:DD:EE:FF
# List   — enroll specific cameras: AA:BB:CC:DD:EE:FF,11:22:33:44:55:66
CAMERA_MACS=all

# --- Network (auto-detected if not set) ---
# NET_INTERFACE=eth0
# RELAY_IP=192.168.1.100
# GATEWAY_IP=192.168.1.1

# --- Tuning (optional) ---
# LAN_WAIT=15
# SUBSCRIBE_WAIT=3
# LOG_LEVEL=info

# ─── Optional: Stream Metrics Overlay ──────────────────────────────────────
# Burns live metrics (battery %, bitrate, fps) into the video frame.
# Requires: STREAM_OVERLAY=1 docker compose --profile overlay up
# Adds native amd64 ffmpeg re-encode (~100ms latency). Default: off.
# STREAM_OVERLAY=1

# TCP port base for bridge↔overlay IPC (one port per camera, incrementing)
# Device 0: raw=18000, overlay=19000 | Device 1: raw=18001, overlay=19001
# RAW_PORT_BASE=18000
# OVERLAY_PORT_BASE=19000
