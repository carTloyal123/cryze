# Wyze Doorbell Bridge — Configuration
#
# Copy to .env and fill in your Wyze account credentials.

# --- Wyze Account (required) ---
WYZE_EMAIL=your-email@example.com
WYZE_PASSWORD=your-password
WYZE_KEY_ID=your-key-id
WYZE_API_KEY=your-api-key

# --- Device (required) ---
DOORBELL_IP=192.168.1.81

# --- Optional ---
# CHIME_IP=192.168.1.12
# GATEWAY_IP=192.168.1.1
# NET_INTERFACE=eth0
# RELAY_IP=               # Auto-detected from DOORBELL_IP subnet
# SKIP_WAKEUP=0           # Set to 1 if doorbell is already connected via keepalive
# LAN_ONLY=1              # Block cloud TCP relay servers (force LAN video)
