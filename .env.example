# Wyze Doorbell Bridge — Configuration
# Copy to .env and fill in your credentials.

# --- Wyze Account (required) ---
WYZE_EMAIL=your-email@example.com
WYZE_PASSWORD=your-password
WYZE_KEY_ID=your-key-id
WYZE_API_KEY=your-api-key

# --- Device IPs (required, find in your router's client list) ---
DOORBELL_IP=192.168.1.81
CHIME_IP=192.168.1.12

# --- Bridge Settings ---
P2P_URL=|18.118.90.161
RELAY_MODE=relay
RELAY_KEEPALIVE=1
LAN_ONLY=1
LAN_WAIT=15
SUBSCRIBE_WAIT=3
SKIP_WAKEUP=0

# --- Optional ---
# GATEWAY_IP=192.168.1.1
# LOG_LEVEL=info
