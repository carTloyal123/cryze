# Wyze Doorbell Bridge — Configuration
#
# Copy this file to .env and fill in your credentials.
# See README.md for deployment tier details.

# ============================================================
# REQUIRED: Wyze account credentials
# ============================================================

WYZE_EMAIL=you@example.com
WYZE_PASSWORD=your-password-here

# API keys — get these from https://developer-api-console.wyze.com/
WYZE_KEY_ID=your-key-id
WYZE_API_KEY=your-api-key

# ============================================================
# TIER 1: Local Relay + Mars Signaling (default)
# ============================================================
# The bridge runs a local GUTES relay for signaling (LIST, DETECT,
# CERTIFY, INIT_INFO). Mars is used ONLY for the CALLING relay
# (~5.7 KB of UDP signaling). All video flows directly on LAN.

# P2P server URL. "|127.0.0.1" = use local relay (recommended).
# For real Mars: "|<mars_ip>" (e.g., "|18.118.90.161")
P2P_URL=|127.0.0.1

# Relay mode: "relay" (fully local) or "proxy" (forward to Mars)
RELAY_MODE=relay

# Block cloud TCP relay servers via iptables (forces LAN-only video).
# Set to 1 to eliminate the 13% of video that goes through cloud relays.
LAN_ONLY=1

# Skip LAN broadcast poll (doorbell doesn't respond to broadcast).
# Mars-mediated CALLING is the working path — set to 0.
LAN_WAIT=0

# Subscribe timeout. In relay mode, subscribe always fails gracefully.
# Lower = faster startup (3-5s recommended).
SUBSCRIBE_WAIT=5

# ============================================================
# TIER 2: Fully Offline (requires router DNAT)
# ============================================================
# Uncomment these for zero external connections.
# Also requires a DNAT rule on your router — see README.md.

# Skip cloud wakeup API call (doorbell stays awake via relay keepalive)
#SKIP_WAKEUP=1

# ============================================================
# DEVICE CONFIGURATION
# ============================================================

# Doorbell LAN IP (used for CALLING ACK and MTP_RES_RESP)
#DOORBELL_IP=192.168.1.81

# Doorbell P2P port (default 8899, used for LAN injection fallback)
#DOORBELL_PORT=8899

# Chime LAN IP (optional, for future local wakeup support)
#CHIME_IP=192.168.1.12

# If you have multiple cameras, specify which one to stream.
# Leave blank to auto-detect the first GW_ model (doorbell).
#DEVICE_MAC=

# ============================================================
# ADVANCED / DEBUGGING
# ============================================================

# P2P port type: 0=IPv6+IPv4 broadcast, 1=IPv4 only, 2=IPv4 alt
#P2P_PORT_TYPE=0

# Auth token cache file (7-day Mars token TTL)
#CACHE_FILE=cache/auth.json

# Relay keepalive (send KEEPALIVE to doorbell every 25s)
#RELAY_KEEPALIVE=1

# Upstream Mars relay (only used in proxy mode, auto-resolved from DNS)
#RELAY_UPSTREAM=3.13.212.24:28800

# MTP TCP relay port (for local MTP bridging)
#MTP_PORT=23000

# Local IP for relay (used in CALLING ACK netaddr field)
#LOCAL_IP=192.168.1.245
